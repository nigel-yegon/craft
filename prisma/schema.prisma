// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "./prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Payments: Invoices & M-Pesa Transactions ─────────────────────

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  customerName  String
  customerPhone String
  description   String?
  amount        Int
  status        String    @default("PENDING")
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions  MpesaTransaction[]

  @@index([status])
  @@index([customerPhone])
}

model MpesaTransaction {
  id                 Int       @id @default(autoincrement())
  invoiceId          Int?
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id])
  merchantRequestId  String?
  checkoutRequestId  String?   @unique
  mpesaReceiptNumber String?   @unique
  phoneNumber        String
  amount             Int
  status             String    @default("PENDING")
  resultCode         String?
  resultDesc         String?
  rawCallback        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([checkoutRequestId])
}

// ─── Catalogue & quote requests (Milestone 1) ────────────────────

model Offering {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  description       String
  kind              String   // "SUBSCRIPTION" | "PRODUCT" | "SERVICE"
  category          String

  pricingMode       String   // "FIXED" | "QUOTE" | "RECURRING"
  fixedPrice        Int?     // present when pricingMode = FIXED | RECURRING
  recurringInterval String?  // "MONTHLY" | "QUARTERLY" | "ANNUAL"

  imageUrl          String?
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())

  quoteRequestItems QuoteRequestItem[]

  @@index([kind])
  @@index([category])
  @@index([active])
}

model QuoteRequest {
  id            Int      @id @default(autoincrement())
  reference     String   @unique   // "QR-2026-0001"

  customerName  String
  customerEmail String
  customerPhone String
  company       String?
  notes         String?

  status        String   @default("NEW")
  // NEW → REVIEWING → QUOTED → INVOICED → PAID → CANCELLED

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         QuoteRequestItem[]
  // quote      Quote?   ← deferred to Milestone 2

  @@index([status])
  @@index([customerEmail])
}

model QuoteRequestItem {
  id             Int          @id @default(autoincrement())
  quoteRequestId Int
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  offeringId     Int?
  offering       Offering?    @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  // Snapshot at time of request — protects history if the offering changes
  offeringName   String
  offeringKind   String
  pricingMode    String

  quantity       Int          @default(1)
  notes          String?

  @@index([quoteRequestId])
}