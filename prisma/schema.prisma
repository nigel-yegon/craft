// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Payments ─────────────────────────────────────────────────────

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  customerName  String
  customerPhone String
  customerEmail String?
  description   String?
  amount        Int
  status        String    @default("PENDING")
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quoteId       Int?      @unique
  quote         Quote?    @relation(fields: [quoteId], references: [id])

  transactions  MpesaTransaction[]

  @@index([status])
  @@index([customerPhone])
}

model MpesaTransaction {
  id                 Int       @id @default(autoincrement())
  invoiceId          Int?
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id])
  merchantRequestId  String?
  checkoutRequestId  String?   @unique
  mpesaReceiptNumber String?   @unique
  phoneNumber        String
  amount             Int
  status             String    @default("PENDING")
  resultCode         String?
  resultDesc         String?
  rawCallback        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  source        String    @default("invoice") // "invoice" | "subscription"
  subscriptionPlan String? // "weekly" | "monthly" | "yearly"

  @@index([source])

  @@index([invoiceId])
  @@index([status])
  @@index([checkoutRequestId])
}

// ─── Catalogue ────────────────────────────────────────────────────

model Offering {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  description       String
  kind              String
  category          String

  pricingMode       String
  fixedPrice        Int?
  recurringInterval String?

  imageUrl          String?
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())

  quoteRequestItems QuoteRequestItem[]

  @@index([kind])
  @@index([category])
  @@index([active])
}

// ─── Quote requests → quotes → invoices ───────────────────────────

model QuoteRequest {
  id            Int      @id @default(autoincrement())
  reference     String   @unique

  customerName  String
  customerEmail String
  customerPhone String
  company       String?
  notes         String?

  status        String   @default("NEW")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         QuoteRequestItem[]
  quote         Quote?

  @@index([status])
  @@index([customerEmail])
}

model QuoteRequestItem {
  id             Int          @id @default(autoincrement())
  quoteRequestId Int
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  offeringId     Int?
  offering       Offering?    @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  offeringName   String
  offeringKind   String
  pricingMode    String

  quantity       Int          @default(1)
  notes          String?

  @@index([quoteRequestId])
}

model Quote {
  id             Int          @id @default(autoincrement())
  reference      String       @unique
  quoteRequestId Int          @unique
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  lineItems      Json
  subtotal       Int
  taxAmount      Int          @default(0)
  total          Int
  currency       String       @default("KES")

  validUntil     DateTime?
  notes          String?

  status         String       @default("DRAFT")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoice        Invoice?
  project        Project?

  @@index([status])
  @@index([createdAt])
}

// ─── Portfolio ────────────────────────────────────────────────────

model Project {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  summary         String
  description     String    @db.Text

  status          String    @default("IN_PROGRESS")
  // PLANNED | IN_PROGRESS | COMPLETED | ON_HOLD | ARCHIVED

  category        String
  clientName      String
  clientContact   String?
  clientIndustry  String?

  costKes         Int?
  durationWeeks   Int?
  startDate       DateTime?
  endDate         DateTime?

  processes       String[]  @default([])
  technologies    String[]  @default([])

  coverImage      String?
  galleryImages   String[]  @default([])

  featured        Boolean   @default(false)
  published       Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Link back to the quote this project was sold through (optional)
  quoteId         Int?      @unique
  quote           Quote?    @relation(fields: [quoteId], references: [id])

  // Costs incurred delivering this project
  expenses        Expense[]

  @@index([status])
  @@index([category])
  @@index([published])
  @@index([featured])
}

// ─── Accounting: Expenses ─────────────────────────────────────────

model Expense {
  id          Int      @id @default(autoincrement())
  reference   String   @unique   // "EXP-2026-0001"
  description String
  category    String   // "Software" | "Contractor" | "Equipment" | "Travel" | "Office" | "Other"
  amount      Int      // KES
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  incurredAt  DateTime
  paidAt      DateTime?
  vendorName  String?

  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([projectId])
  @@index([incurredAt])
}

model Notification {
  id          String   @id @default(uuid())
  businessId  String
  type        String
  title       String
  body        String   @default("")
  actionRoute String?
  payload     Json?
  publishedAt DateTime @default(now())

  @@index([businessId, publishedAt])
  @@map("notifications")
}
// ─── POS Store Items ──────────────────────────────────────────────
// Items managed by admin, synced down to Flutter POS apps.
// Linked to a shop by `businessId` (matches the Flutter SQLite DB's business).

model StoreItem {
  id                     Int      @id @default(autoincrement())
  businessId             String

  name                   String
  description            String?
  sku                    String?
  barcode                String?
  categoryName           String?

  // Prices in KES cents (minor units) — matches Flutter's minor-unit model
  sellingPriceMinor      Int
  costPriceMinor         Int?

  // Stock in milli-units — 1000 = 1 unit (matches Flutter's quantityMilli)
  stockMilli             Int      @default(0)
  lowStockThresholdMilli Int      @default(5000)  // 5 units

  imageUrl               String?
  isActive               Boolean  @default(true)

  // "admin" = created from the panel, "phone" = created on the Flutter app
  source                 String   @default("admin")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, updatedAt])  // for delta sync
}
// ─── Team ─────────────────────────────────────────────────────────

model TeamMember {
  id              Int      @id @default(autoincrement())
  slug            String   @unique

  name            String
  role            String                     // "Design Lead", "Software Engineer", etc.
  bio             String   @db.Text          // markdown-capable long bio
  shortBio        String?                    // 1–2 sentence teaser for cards

  photoUrl        String?
  email           String?
  phone           String?

  

  // Fields of expertise — stored as PostgreSQL text[] for fast filtering
  expertise       String[] @default([])
  disciplines     String[] @default([])      // "architecture", "interiors", "software", etc.

  // Social links
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?
  websiteUrl      String?

  // Meta
  joinedAt        DateTime?                  // when they joined the studio
  location        String?                    // "Nairobi, Kenya"
  yearsExperience Int?

  // Ordering + visibility
  sortOrder       Int      @default(0)
  featured        Boolean  @default(false)
  published       Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([sortOrder])

  
 journalPosts JournalPost[]     // ⭐ relation from JournalPost.authorId
}

// ─── Journal ──────────────────────────────────────────────────────

model JournalPost {
  id              Int      @id @default(autoincrement())
  slug            String   @unique

  title           String
  subtitle        String?                    // optional dek / subheading
  excerpt         String   @db.Text          // teaser shown on listing page
  content         String   @db.Text          // full markdown body

  coverImageUrl   String?
  galleryUrls     String[] @default([])

  category        String   @default("STUDIO") // "STUDIO" | "PROCESS" | "TECH" | "CASE_STUDY" | "CULTURE" | "ANNOUNCEMENT"
  tags            String[] @default([])

  authorId        Int?
  author          TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  readTimeMinutes Int?                       // computed or stored
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([featured])
}
model Business {
  id        String   @id
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
model BusinessBackup {
  id         String   @id @default(cuid())
  businessId String
  filename   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}