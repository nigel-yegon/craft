generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"   // ← this path is relative to schema.prisma
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  passwordHash String?
  createdAt DateTime @default(now())
}